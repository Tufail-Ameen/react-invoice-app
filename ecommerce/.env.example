# Base URL of the API. Jab tak aapka asli backend nahi bana, MSW isi URL ko intercept karta hai.
# Asli backend banane ke baad sirf ye URL badlein aur VITE_ENABLE_MOCK_API=false kar dein.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# true  -> MSW mock backend chalega (browser ke andar)
# false -> requests seedhi VITE_API_BASE_URL par jayengi
VITE_ENABLE_MOCK_API=true
