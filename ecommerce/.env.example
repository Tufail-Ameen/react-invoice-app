# Base URL of the API. Jab tak aapka asli backend nahi bana, MSW isi URL ko intercept karta hai.
# Asli backend banane ke baad sirf ye URL badlein aur VITE_ENABLE_MOCK_API=false kar dein.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# true  -> MSW mock backend chalega (browser ke andar)
# false -> requests seedhi VITE_API_BASE_URL par jayengi
VITE_ENABLE_MOCK_API=true

# Real auth backend (defaults to http://localhost:5002)
VITE_REGISTER_API_URL=http://localhost:5002

# true -> register uses MSW mock at VITE_API_BASE_URL/auth/register
# false -> register hits VITE_REGISTER_API_URL/register (default)
VITE_USE_MOCK_REGISTER=false

# true -> login uses MSW mock at VITE_API_BASE_URL/auth/login
# false -> login hits VITE_REGISTER_API_URL/login (default)
VITE_USE_MOCK_LOGIN=false
